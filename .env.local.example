# Supabase baglanti bilgileri (Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Apex domain (root domain). Subdomain/custom_domain ayrimi icin kullanilir.
# Lokal: lvh.me (port'suz)
# Production: sendika-site.vercel.app
# Eksik birakilirsa "lvh.me" fallback'i kullanilir (graceful degradation).
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me

# Iletisim formu rate-limit IP hash'i icin salt (gizlilik/KVKK).
# Ham IP saklanmaz; /api/contact route'unda IP + bu salt SHA-256'lanir.
# Eksik birakilirsa sabit bir fallback kullanilir (calisir ama production'da
# benzersiz, gizli bir deger onerilir — Vercel'e de eklenmeli).
CONTACT_IP_SALT=change-me-to-a-random-secret
