# Supabase baglanti bilgileri (Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Apex domain (root domain). Subdomain/custom_domain ayrimi icin kullanilir.
# Lokal: lvh.me (port'suz)
# Production: sendika-site.vercel.app
# Eksik birakilirsa "lvh.me" fallback'i kullanilir (graceful degradation).
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me

# Davet maillerindeki linkin donecegi ADRES (sema dahil, sonda slash yok).
# YALNIZCA production'da kullanilir; lokalde davet linki otomatik olarak
# http://{tenant-slug}.lvh.me:3000/admin/davet-kabul olur.
#
# Kullanan: lib/super-admin/admin-invite.ts -> buildInviteRedirectUrl()
#   (super-admin/create-tenant ve super-admin/tenant-users route'lari)
# Uretilen adres: {NEXT_PUBLIC_SITE_URL}/admin/davet-kabul
#
# Bu adres Supabase Dashboard -> Authentication -> URL Configuration ->
# "Redirect URLs" listesinde de TANIMLI OLMALI; aksi halde Supabase linki
# kabul etmez ve kullaniciyi proje Site URL'ine dusurur.
#
# Eksik birakilirsa production'da sunucu log'una hata yazilir ve redirect
# verilmeden davet gonderilir (Supabase proje Site URL'ine duser).
NEXT_PUBLIC_SITE_URL=https://sendika-site.vercel.app

# Iletisim formu rate-limit IP hash'i icin salt (gizlilik/KVKK).
# Ham IP saklanmaz; /api/contact route'unda IP + bu salt SHA-256'lanir.
# Eksik birakilirsa sabit bir fallback kullanilir (calisir ama production'da
# benzersiz, gizli bir deger onerilir — Vercel'e de eklenmeli).
CONTACT_IP_SALT=change-me-to-a-random-secret
